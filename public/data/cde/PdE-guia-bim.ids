      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet><ids:simpleValue>03_PdE_Proyecto</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>03_01_PdE_Fase Obra</ids:simpleValue></ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet><ids:simpleValue>03_PdE_Proyecto</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>03_02_PdE_Planos</ids:simpleValue></ids:baseName>
          <ids:value><xs:restriction base="xs:string"><xs:pattern value="https?://.+"/></xs:restriction></ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet><ids:simpleValue>03_PdE_Proyecto</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>03_03_PdE_PPTP</ids:simpleValue></ids:baseName>
          <ids:value><xs:restriction base="xs:string"><xs:pattern value="https?://.+"/></xs:restriction></ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet><ids:simpleValue>03_PdE_Proyecto</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>03_04_01_PdE_Ud Medición 01</ids:simpleValue></ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
