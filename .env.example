# Todas son OPCIONALES. Sin ninguna, la app funciona entera (OSM, relieve ICGC, ortofoto, IFC del Port).

# Teselas 3D hiperrealistas en el mapa (formato OGC 3D Tiles), una de las dos:
#  - tileset.json propio, por ejemplo el modelo 3D de Barcelona convertido y subido a R2:
VITE_TILES3D_URL=
#    (con R2: VITE_TILES3D_URL=/api/assets/bcn3d/tileset.json)
#  - o Google Photorealistic 3D Tiles (clave de Google Maps Platform con "Map Tiles API" activada):
VITE_GOOGLE_MAPS_KEY=

# FIWARE directo desde el navegador (el broker debe permitir CORS). Mejor usar FIWARE_URL en Cloudflare.
VITE_FIWARE_URL=
# 'v2' (NGSI-v2, Orion) o 'ld' (NGSI-LD, Orion-LD / Scorpio / Stellio)
VITE_FIWARE_NGSI=v2
# tipos de Smart Data Models a leer, separados por comas
VITE_FIWARE_TYPES=TrafficFlowObserved,AirQualityObserved,OffStreetParking,ParkingSpot,WeatherObserved,NoiseLevelObserved
